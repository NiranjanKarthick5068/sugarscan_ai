# JSON Web Token (JWT) settings
SECRET_KEY="production_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (Required for Auth & Postgres DB)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Ollama AI Configuration (Point to DigitalOcean VPS in production)
OLLAMA_BASE_URL="http://your-do-droplet-ip"
OLLAMA_VISION_MODEL="moondream"
OLLAMA_LLM_MODEL="phi3:mini"
OLLAMA_CHAT_MODEL="phi3:mini"
OLLAMA_MINI_MODEL="phi3:mini"

# File Uploads
MEDIA_DIR="./media/uploads"
MAX_IMAGE_SIZE_MB=10

# Environment
ENVIRONMENT="production"

# USDA API Key for dataset auto-fetch
USDA_API_KEY="your_usda_api_key_here"
